{
  // You may need to set the following line in your settings.json
  "betterStatusBar.configurationFile": "/config/workspace/.vscode/statusbar.jsonc",
  // This JSON could also be set directly in the settings.json file.
  "betterStatusBar.defaultColor": "statusBar.foreground",
  // "betterStatusBar.loadNpmCommands": false,
  // Set this to null to reload on configuration change in settings or this file.
  "betterStatusBar.reloadButton": null,
  "betterStatusBar.commands": [
    // Git status
    {
      "id": "status",
      "label": "Git Status",
      "command": "git status",
      "color": "orange",
      // 1 = left side | 2 = right side
      "alignment": 1,
      // Determines the location of the button. Higher priority is farther to the left.
      "priority": -1000,
      // Change this to false if you only want the button to show in the dropdown.
      "showButton": true,
      "terminal": {
        // Setting a name allows the terminal to be re-used by other commands with the same name.
        "name": "temp",
        "singleInstance": true,
        "clear": true,
        "focus": false,
      },
    },
    // Echo 'Hello'
    {
      // The label makes adding the command to the dropdown easier.
      "id": "10",
      "label": "▶️ Hello ${fileBasename}",
      "command": "echo 'Hello' ${fileBasename}",
      "color": "orange",
      // 1 = left side | 2 = right side
      "alignment": 1,
      // Determines the location of the button. Higher priority is farther to the left.
      "priority": -100,
      // Setting this to null defaults to the command value (which you could then use to add a keyboard shortcut to) as the tooltip text.
      "tooltip": "echo 'Hello' ${fileBasename}",
      // Change this to false if you only want the button to show in the dropdown.
      "showButton": true,
      "terminal": {
        // Setting a name allows the terminal to be re-used by other commands with the same name.
        "name": "temp",
        // cwd resolves from the root of the window.
        "cwd": "./terminal",
        "singleInstance": true,
        "clear": true,
        "focus": false,
      },
    },
    // Split editor
    {
      "id": "split.editor",
      "label": "$(split-horizontal) Split editor",
      "command": "workbench.action.splitEditor",
      "color": "orange",
      // 1 = left side | 2 = right side
      "alignment": 2,
      // Determines the location of the button. Higher priority is farther to the left.
      "priority": 1000,
      // Change this to false if you only want the button to show in the dropdown.
      "showButton": true,
      "useVsCodeApi": true,
    },
  ],
  "betterStatusBar.dropdowns": [
    {
      "id": "dropdown",
      "label": "Dropdown",
      // The id or the label can be used to show the commands.
      "commands": ["status", "10", "split.editor"],
      "tooltip": "tooltip",
      "color": "orange",
    },
  ],
}
